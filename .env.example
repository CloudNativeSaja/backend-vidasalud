# Copiar a .env en el servidor (cp .env.example .env) y cambiar los valores.
# .env esta en .gitignore: nunca se sube a git.

# --- Base de datos (MariaDB en contenedor) ---
DB_ROOT_PASSWORD=cambiar-root
DB_USERNAME=vidasalud
DB_PASSWORD=cambiar-app

# --- Entra ID (BFF) ---
AZURE_ISSUER=https://login.microsoftonline.com/990d84ca-63d0-44d9-89f7-3515a5520b0c/v2.0
AZURE_AUDIENCE=964063ab-9c14-41ca-9ecb-9b6d3891e750

# --- RabbitMQ (clúster de 2 nodos en su propia EC2; ver infra/mq) ---
# Local con Docker Desktop:  host.docker.internal:5672,host.docker.internal:5673
# En AWS: IP privada de la EC2 de RabbitMQ, ej. 172.31.x.x:5672,172.31.x.x:5673
RABBITMQ_ADDRESSES=host.docker.internal:5672,host.docker.internal:5673
RABBITMQ_USER=vidasalud
RABBITMQ_PASSWORD=cambiar-rabbit
# API HTTP de RabbitMQ Management (solo la usa mq-admin)
RABBITMQ_MANAGEMENT_URL=http://host.docker.internal:15672
# true = publica comandos; false = la API funciona sin mensajeria
MESSAGING_ENABLED=true
# true solo para la demo de fallos (paciente FALLA-TEMPORAL / FALLA-PERMANENTE)
NOTIFY_SIMULATION_ENABLED=false
